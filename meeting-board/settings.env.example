# 이 파일을 settings.env 로 복사한 뒤 값을 채우세요. settings.env 는 절대 공유하지 마세요.

# 토론방 웹페이지 비밀번호 (아이디는 아무거나 입력)
RUNNER_PASSWORD=

# Gemini API 키: https://aistudio.google.com 에서 발급
GEMINI_API_KEY=
# Gemini 모델 (무료 티어는 모델별 하루 20회. 비워두면 gemini-3.1-flash-lite)
GEMINI_MODEL=

# OpenAI(ChatGPT) API 키: https://platform.openai.com 에서 발급 (ChatGPT Plus 구독과 별도, 쓴 만큼 과금)
OPENAI_API_KEY=
# ChatGPT 모델 이름 (필수). 목록: sudo docker run --rm --env-file settings.env ai-debate python tools/list_models.py chatgpt
OPENAI_MODEL=

# Grok API 키: https://console.x.ai 에서 발급 (Grok을 안 쓰면 비워두기)
XAI_API_KEY=
# Grok 모델 이름 (필수). 목록: sudo docker run --rm --env-file settings.env ai-debate python tools/list_models.py grok
GROK_MODEL=

# Claude 모델 (선택). 비워두면 Claude Code 기본 모델. 예: sonnet, opus, haiku (haiku가 가장 빠름)
CLAUDE_MODEL=

# Claude 구독 토큰: 내 컴퓨터 터미널에서 `claude setup-token` 실행 후 나온 토큰 (sk-ant-oat01-로 시작)
CLAUDE_CODE_OAUTH_TOKEN=
# Anthropic API 키 (sk-ant-api03-로 시작). 구독 토큰을 쓰면 여기는 비워 두세요.
ANTHROPIC_API_KEY=
