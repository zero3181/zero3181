# 이 파일을 settings.env 로 복사한 뒤 값을 채우세요. settings.env 는 절대 공유하지 마세요.

# 토론방 웹페이지 비밀번호 (아이디는 아무거나 입력)
RUNNER_PASSWORD=

# Gemini API 키: https://aistudio.google.com 에서 발급
GEMINI_API_KEY=
# Gemini 모델 (무료 티어는 모델별 하루 20회. 비워두면 gemini-3.1-flash-lite)
GEMINI_MODEL=

# Claude 구독 토큰: 내 컴퓨터 터미널에서 `claude setup-token` 실행 후 나온 토큰
CLAUDE_CODE_OAUTH_TOKEN=
# (구독 대신 API 키로 쓰려면 위를 비우고 아래에 입력. 사용량만큼 과금)
ANTHROPIC_API_KEY=
